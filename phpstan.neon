includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 3
    paths:
        - src
        - database
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        # Missing the trailing template param on relation returns (e.g. HasMany<X> instead of
        # HasMany<X, $this>) doesn't affect runtime behavior - just generics completeness nagging.
        -
            identifiers:
                - generics.lessTypes
                - return.type
            path: src/Models
        # Models don't carry @property docblocks and Larastan's migration schema-scan doesn't
        # pick up every column, so it can't always see attributes set via $fillable/$casts.
        -
            identifier: property.notFound
